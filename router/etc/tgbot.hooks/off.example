#!/bin/sh
# Копия в /etc/tgbot.hooks/off (chmod 700). Вызывается кнопкой «Выключить» в Telegram
# (вопрос «дома никого, а включено ...» и «Меню → Дом → Выключить всё»).
# Замените <ID> на webhook_id автоматизации «Выключить свет, розетки, телевизор и кондиционеры».
curl -s -m 10 -X POST http://192.168.8.112:8123/api/webhook/<ID> >/dev/null
