# Скопируйте в /etc/tgbot.conf на роутере и заполните. Права: chmod 600
TOKEN=123456789:AA...токен_от_BotFather
CHAT_ID=123456789

# Необязательно:
# Пароль шифрования бэкапа конфигурации (AES-256). Без него /backup и еженедельный бэкап выключены.
# Запомните его: без него бэкап не расшифровать.
#BACKUP_PASS=длинная_случайная_фраза
# Адрес пинга healthchecks.io: сервис сообщит, если роутер совсем пропал (бот сам об этом сказать не может).
#HC_URL=https://hc-ping.com/ваш-uuid
# Внешний адрес или DDNS-имя роутера для VPN-конфигов (по умолчанию берётся WAN IP).
#VPN_ENDPOINT=vpn.example.com
# Сколько секунд показывать краткий итог после нажатия кнопки (0 = не удалять).
#UI_TOAST=6
